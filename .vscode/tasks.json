{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docker Compose: Start",
      "type": "shell",
      "command": "docker compose up --build --wait --wait-timeout 180 --detach",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Docker Compose: Stop",
      "type": "shell",
      "command": "docker compose down --remove-orphans",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
