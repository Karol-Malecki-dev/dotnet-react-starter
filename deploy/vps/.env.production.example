# Deployment artifact coordinates
BACKEND_IMAGE=ghcr.io/your-github-owner/dotnet-react-starter-backend
FRONTEND_IMAGE=ghcr.io/your-github-owner/dotnet-react-starter-frontend
IMAGE_TAG=replace-with-full-commit-sha

# Public TLS endpoint
APP_DOMAIN=staging.example.com
TLS_EMAIL=operations@example.com

# PostgreSQL
POSTGRES_DB=dotnetreact
POSTGRES_USER=dotnetreact
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Authentication
JWT_SECRET=replace-with-at-least-64-random-characters
JWT_ISSUER=Dotnet-React-Starter-API
JWT_AUDIENCE=Dotnet-React-Starter-App
DATA_PROTECTION_APPLICATION_NAME=DotnetReactStarter

# Private object storage
MINIO_ROOT_USER=replace-with-private-root-user
MINIO_ROOT_PASSWORD=replace-with-a-long-random-root-password
MINIO_APP_ACCESS_KEY=replace-with-private-application-user
MINIO_APP_SECRET_KEY=replace-with-a-long-random-application-password
# External SMTP provider
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_FROM_NAME=Dotnet React Starter
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_USE_STARTTLS=true

# Monitoring is bound to VPS loopback and accessed through an SSH tunnel.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-dashboard-password
